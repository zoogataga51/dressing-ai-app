 "mailer_templates_magic_link_content": "<!doctype html><html lang=\"fr\"><body style=\"margin:0;background:#F6F3EE\">\n<div style=\"background:#F6F3EE;padding:32px 16px;font-family:Helvetica,Arial,sans-serif;color:#15151C\">\n  <div style=\"max-width:440px;margin:0 auto;background:#ffffff;border-radius:24px;padding:32px 28px\">\n    <p style=\"margin:0 0 18px;font-size:13px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#2B44C6\">Dressing AI</p>\n    <h1 style=\"margin:0 0 12px;font-size:26px;line-height:30px\">Ton code de connexion</h1>\n    <p style=\"margin:0 0 22px;font-size:16px;line-height:23px;color:#55555F\">Recopie ce code dans l’appli pour retrouver ta garde-robe.</p>\n    <p style=\"margin:0 0 22px;font-size:38px;font-weight:800;letter-spacing:10px;color:#2B44C6\">{{ .Token }}</p>\n    <p style=\"margin:0 0 22px;font-size:14px;line-height:20px;color:#55555F\">Tu lis cet e-mail sur ton téléphone ? Tu peux aussi <a href=\"{{ .ConfirmationURL }}\" style=\"color:#2B44C6\">toucher ce lien</a>.</p>\n    <p style=\"margin:0;font-size:13px;line-height:19px;color:#8A8A93\">Ce code est valable 15 minutes. Si tu n’as rien demandé, ignore simplement ce message.</p>\n  </div>\n  <p style=\"max-width:440px;margin:16px auto 0;font-size:12px;color:#8A8A93;text-align:center\">Dressing AI · dressingai.fr</p>\n</div></body></html>",
