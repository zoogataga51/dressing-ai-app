{
  "expo": {
    "name": "Dressing AI",
    "slug": "dressing-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dressingai.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B44C6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dressingai.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F3EE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dressing AI a besoin de tes photos pour ajouter tes vêtements.",
          "cameraPermission": "Dressing AI a besoin de l’appareil photo pour photographier tes vêtements."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "dressingai",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "dressing-ai.com",
    "description": "Chaque matin, des looks composés avec tes propres vêtements, selon la météo et ton humeur.",
    "locales": {
      "fr": "./locales/fr.json"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5acb6e9b-6ef9-4b80-9c19-04c30173c09e"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5acb6e9b-6ef9-4b80-9c19-04c30173c09e"
    }
  }
}
